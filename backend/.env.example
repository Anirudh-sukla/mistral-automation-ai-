# Example environment variables
# Copy this file to .env and fill values.

# App
APP_NAME=Nexus Godzilla - Backend
DEBUG=True
PORT=8000

# Database (sqlite example)
DATABASE_URL=sqlite+aiosqlite:///./backend.db

# Model settings
MODEL_MODE=local
# If using a local quantized Qwen3.5:4B model, set MODEL_PATH to its folder or repo id
MODEL_PATH=path/to/quantized/qwen-3.5-4b

# Optional remote API (fallback)
# REMOTE_API_PROVIDER=openai
# REMOTE_API_KEY=sk-...
