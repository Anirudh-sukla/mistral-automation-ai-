# Environment example for the backend
# Copy to .env and edit as needed

# Model config
MODEL_MODE=local
MODEL_PATH=
# If you prefer remote generation, set MODEL_MODE=remote and provide OPENAI_API_KEY
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Database (defaults to sqlite for quick start)
DATABASE_URL=sqlite+aiosqlite:///./backend.db

# SMTP (for sending proposals)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Stripe (test mode)
STRIPE_API_KEY=
